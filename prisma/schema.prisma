// Sree Krishna Motors – Rental Management System
// See docs/03-database-design.md. Constraints Prisma cannot express
// (CHECKs, partial unique indexes) live in hand-written SQL in the migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum Locale {
  en
  ml
}

enum DocType {
  ORDER
  INVOICE
  RECEIPT
  REFUND
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  fullName           String    @map("full_name")
  passwordHash       String    @map("password_hash")
  role               Role
  locale             Locale    @default(en)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  // Bumped on password reset / deactivation / role change so existing sessions die immediately.
  sessionVersion     Int       @default(1) @map("session_version")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  auditLogs        AuditLog[]
  settingsUpdates  Settings[]

  @@map("users")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   Int?     @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  summary   Json?
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NumberSequence {
  docType    DocType @map("doc_type")
  fiscalYear String  @map("fiscal_year")
  nextValue  Int     @default(1) @map("next_value")

  @@id([docType, fiscalYear])
  @@map("number_sequences")
}

model Settings {
  id                 Int      @id @default(1)
  businessName       String   @map("business_name")
  businessNameMl     String?  @map("business_name_ml")
  address            String?
  addressMl          String?  @map("address_ml")
  phones             String?
  email              String?
  orderPrefix        String   @default("ORD") @map("order_prefix")
  invoicePrefix      String   @default("INV") @map("invoice_prefix")
  receiptPrefix      String   @default("RCP") @map("receipt_prefix")
  refundPrefix       String   @default("RFD") @map("refund_prefix")
  invoiceTerms       String?  @map("invoice_terms")
  invoiceTermsMl     String?  @map("invoice_terms_ml")
  logoPath           String?  @map("logo_path")
  printPaperWidthMm  Int      @default(80) @map("print_paper_width_mm")
  updatedById        Int?     @map("updated_by")
  updatedBy          User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}
