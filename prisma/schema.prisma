// Sree Krishna Motors – Rental Management System
// See docs/03-database-design.md. Constraints Prisma cannot express
// (CHECKs, partial unique indexes) live in hand-written SQL in the migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum Locale {
  en
  ml
}

enum DocType {
  ORDER
  INVOICE
  RECEIPT
  REFUND
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  fullName           String    @map("full_name")
  passwordHash       String    @map("password_hash")
  role               Role
  locale             Locale    @default(en)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  // Bumped on password reset / deactivation / role change so existing sessions die immediately.
  sessionVersion     Int       @default(1) @map("session_version")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  auditLogs         AuditLog[]
  settingsUpdates   Settings[]
  customersCreated  Customer[]
  stockMovements    StockMovement[]
  ordersCreated     RentalOrder[]   @relation("OrderCreatedBy")
  ordersCancelled   RentalOrder[]   @relation("OrderCancelledBy")
  issues            Issue[]
  linesVoided       IssueLine[]
  returnsReceived   Return[]        @relation("ReturnReceivedBy")
  returnsVoided     Return[]        @relation("ReturnVoidedBy")
  invoicesCreated   Invoice[]       @relation("InvoiceCreatedBy")
  invoicesCancelled Invoice[]       @relation("InvoiceCancelledBy")

  @@map("users")
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum LineStatus {
  ACTIVE
  VOIDED
}

model RentalOrder {
  id            Int         @id @default(autoincrement())
  orderNo       String      @unique @map("order_no")
  customerId    Int         @map("customer_id")
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status        OrderStatus @default(OPEN)
  siteAddress   String?     @map("site_address")
  notes         String?
  openedOn      DateTime    @map("opened_on") @db.Date
  closedAt      DateTime?   @map("closed_at") @db.Timestamptz
  cancelledById Int?        @map("cancelled_by")
  cancelledBy   User?       @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime?   @map("cancelled_at") @db.Timestamptz
  cancelReason  String?     @map("cancel_reason")
  createdById   Int         @map("created_by")
  createdBy     User        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  issues   Issue[]
  lines    IssueLine[]
  returns  Return[]
  invoices Invoice[]

  @@index([customerId, status])
  @@index([status, openedOn])
  @@map("rental_orders")
}

model Issue {
  id          Int         @id @default(autoincrement())
  orderId     Int         @map("order_id")
  order       RentalOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  issueDate   DateTime    @map("issue_date") @db.Date
  isBackdated Boolean     @default(false) @map("is_backdated")
  notes       String?
  issuedById  Int         @map("issued_by")
  issuedBy    User        @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  lines IssueLine[]

  @@index([orderId])
  @@map("issues")
}

model IssueLine {
  id          Int          @id @default(autoincrement())
  issueId     Int          @map("issue_id")
  issue       Issue        @relation(fields: [issueId], references: [id], onDelete: Restrict)
  orderId     Int          @map("order_id")
  order       RentalOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId   Int          @map("product_id")
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitId      Int?         @map("unit_id")
  unit        ProductUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  quantity    Int
  qtyReturned Int          @default(0) @map("qty_returned")
  /// Rate snapshot at issue time; later product rate changes never affect it.
  dailyRate   Decimal      @map("daily_rate") @db.Decimal(12, 2)
  status      LineStatus   @default(ACTIVE)
  voidedById  Int?         @map("voided_by")
  voidedBy    User?        @relation(fields: [voidedById], references: [id], onDelete: Restrict)
  voidedAt    DateTime?    @map("voided_at") @db.Timestamptz
  voidReason  String?      @map("void_reason")

  returnLines ReturnLine[]

  @@index([orderId])
  @@index([issueId])
  @@map("issue_lines")
}

enum Tracking {
  SERIALISED
  QUANTITY
}

enum UnitStatus {
  AVAILABLE
  RENTED
  UNDER_REPAIR
  LOST
  RETIRED
}

enum MovementType {
  OPENING
  PURCHASE
  WRITE_OFF
  SENT_TO_REPAIR
  REPAIR_DONE
  REPAIR_SCRAPPED
  RETURN_DAMAGED
  RETURN_LOST
  CORRECTION
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  nameMl   String?   @map("name_ml")
  isActive Boolean   @default(true) @map("is_active")
  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Optional short code, unique when present (e.g. GEN-5KVA).
  code        String?  @unique
  name        String
  nameMl      String?  @map("name_ml")
  tracking    Tracking
  dailyRate   Decimal  @map("daily_rate") @db.Decimal(12, 2)
  /// Counters are changed only by service transactions (docs/02-architecture.md §6).
  qtyOwned    Int      @default(0) @map("qty_owned")
  qtyOut      Int      @default(0) @map("qty_out")
  qtyRepair   Int      @default(0) @map("qty_repair")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  units      ProductUnit[]
  movements  StockMovement[]
  issueLines IssueLine[]

  @@index([categoryId])
  @@map("products")
}

model ProductUnit {
  id        Int        @id @default(autoincrement())
  productId Int        @map("product_id")
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  serialNo  String     @map("serial_no")
  status    UnitStatus @default(AVAILABLE)
  notes     String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  movements  StockMovement[]
  issueLines IssueLine[]

  @@unique([productId, serialNo])
  @@index([productId, status])
  @@map("product_units")
}

model StockMovement {
  id           Int          @id @default(autoincrement())
  productId    Int          @map("product_id")
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitId       Int?         @map("unit_id")
  unit         ProductUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  type         MovementType
  deltaOwned   Int          @map("delta_owned")
  deltaRepair  Int          @map("delta_repair")
  returnLineId Int?         @map("return_line_id")
  returnLine   ReturnLine?  @relation(fields: [returnLineId], references: [id], onDelete: Restrict)
  reason       String?
  createdById  Int          @map("created_by")
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([productId, id])
  @@map("stock_movements")
}

model Customer {
  /// Shown as the customer number.
  id            Int      @id @default(autoincrement())
  name          String
  /// Digits only, normalised (see modules/customers/phone.ts). Not unique: families share numbers.
  phone         String
  altPhone      String?  @map("alt_phone")
  address       String?
  idProofType   String?  @map("id_proof_type")
  idProofNumber String?  @map("id_proof_number")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdById   Int      @map("created_by")
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  orders RentalOrder[]

  @@index([phone])
  @@index([altPhone])
  @@map("customers")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   Int?     @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  summary   Json?
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NumberSequence {
  docType    DocType @map("doc_type")
  fiscalYear String  @map("fiscal_year")
  nextValue  Int     @default(1) @map("next_value")

  @@id([docType, fiscalYear])
  @@map("number_sequences")
}

model Settings {
  id                Int      @id @default(1)
  businessName      String   @map("business_name")
  businessNameMl    String?  @map("business_name_ml")
  address           String?
  addressMl         String?  @map("address_ml")
  phones            String?
  email             String?
  orderPrefix       String   @default("ORD") @map("order_prefix")
  invoicePrefix     String   @default("INV") @map("invoice_prefix")
  receiptPrefix     String   @default("RCP") @map("receipt_prefix")
  refundPrefix      String   @default("RFD") @map("refund_prefix")
  invoiceTerms      String?  @map("invoice_terms")
  invoiceTermsMl    String?  @map("invoice_terms_ml")
  logoPath          String?  @map("logo_path")
  printPaperWidthMm Int      @default(80) @map("print_paper_width_mm")
  updatedById       Int?     @map("updated_by")
  updatedBy         User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

enum ReturnCondition {
  GOOD
  DAMAGED
  LOST
}

model Return {
  id           Int         @id @default(autoincrement())
  orderId      Int         @map("order_id")
  order        RentalOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnDate   DateTime    @map("return_date") @db.Date
  isBackdated  Boolean     @default(false) @map("is_backdated")
  notes        String?
  receivedById Int         @map("received_by")
  receivedBy   User        @relation("ReturnReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  status       LineStatus  @default(ACTIVE)
  voidedById   Int?        @map("voided_by")
  voidedBy     User?       @relation("ReturnVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidedAt     DateTime?   @map("voided_at") @db.Timestamptz
  voidReason   String?     @map("void_reason")

  lines ReturnLine[]

  @@index([orderId])
  @@map("returns")
}

model ReturnLine {
  id           Int             @id @default(autoincrement())
  returnId     Int             @map("return_id")
  return       Return          @relation(fields: [returnId], references: [id], onDelete: Restrict)
  issueLineId  Int             @map("issue_line_id")
  issueLine    IssueLine       @relation(fields: [issueLineId], references: [id], onDelete: Restrict)
  quantity     Int
  condition    ReturnCondition
  /// Calendar-inclusive days from the issue date to the return date (billing engine).
  days         Int
  /// Copied from the issue line.
  dailyRate    Decimal         @map("daily_rate") @db.Decimal(12, 2)
  rentAmount   Decimal         @map("rent_amount") @db.Decimal(12, 2)
  damageAmount Decimal         @default(0) @map("damage_amount") @db.Decimal(12, 2)
  damageNote   String?         @map("damage_note")

  movements StockMovement[]

  @@index([issueLineId])
  @@index([returnId])
  @@map("return_lines")
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

/// Final invoice. Everything printed on it is a snapshot taken at issue time,
/// so it always reprints exactly as issued. At most one ISSUED per order
/// (partial unique index in the migration).
model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNo       String        @unique @map("invoice_no")
  orderId         Int           @map("order_id")
  order           RentalOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status          InvoiceStatus @default(ISSUED)
  invoiceDate     DateTime      @map("invoice_date") @db.Date
  orderNo         String        @map("order_no")
  customerName    String        @map("customer_name")
  customerPhone   String        @map("customer_phone")
  customerAddress String?       @map("customer_address")
  siteAddress     String?       @map("site_address")
  rentTotal       Decimal       @map("rent_total") @db.Decimal(12, 2)
  damageTotal     Decimal       @map("damage_total") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason  String?       @map("discount_reason")
  total           Decimal       @db.Decimal(12, 2)
  createdById     Int           @map("created_by")
  createdBy       User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  cancelledById   Int?          @map("cancelled_by")
  cancelledBy     User?         @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelReason    String?       @map("cancel_reason")

  lines InvoiceLine[]

  @@index([orderId])
  @@index([invoiceDate])
  @@map("invoices")
}

/// Immutable snapshot of one returned batch.
model InvoiceLine {
  id            Int             @id @default(autoincrement())
  invoiceId     Int             @map("invoice_id")
  invoice       Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  sortOrder     Int             @map("sort_order")
  productName   String          @map("product_name")
  productNameMl String?         @map("product_name_ml")
  serialNo      String?         @map("serial_no")
  quantity      Int
  issueDate     DateTime        @map("issue_date") @db.Date
  returnDate    DateTime        @map("return_date") @db.Date
  days          Int
  dailyRate     Decimal         @map("daily_rate") @db.Decimal(12, 2)
  rentAmount    Decimal         @map("rent_amount") @db.Decimal(12, 2)
  condition     ReturnCondition
  damageAmount  Decimal         @default(0) @map("damage_amount") @db.Decimal(12, 2)
  damageNote    String?         @map("damage_note")

  @@unique([invoiceId, sortOrder])
  @@map("invoice_lines")
}
