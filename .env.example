# PostgreSQL 18 connection
DATABASE_URL=postgresql://rms:CHANGE_ME@localhost:5432/rms
# Only for running the test suite (database is wiped per test)
TEST_DATABASE_URL=postgresql://rms:CHANGE_ME@localhost:5432/rms_test

# Session signing secret, 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# true when served over HTTPS (VPS); false on the shop LAN (plain HTTP)
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Kolkata

# true only on the VPS option, behind the documented Caddy reverse proxy,
# which overwrites X-Forwarded-For. Leave false on the shop PC (direct
# connection): there a client could set that header itself and dodge the
# per-IP login lock, so login throttling falls back to username only.
TRUST_PROXY_HEADERS=false

# First admin, used once by `npm run db:seed` (must change password at first login)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Development only: adds a demo staff user
SEED_DEV_DATA=false

# Where nightly database dumps go
BACKUP_DIR=

# PDF rendering: the server opens its own /print pages over loopback.
# Set this only if the app is not reachable at http://127.0.0.1:$PORT.
INTERNAL_BASE_URL=
